{
    "name": "mijnui/mijnui",
    "description": "UI component library for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "paingsoeko",
            "email": "dev.kopaing@gmail.com"
        },
        {
            "name": "WaiYanPhoneAant",
            "email": "waiyanphoneaantse@gmail.com"
        },
        {
            "name": "Zai185",
            "email": "mkhant185@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Mijnui\\Mijnui\\": "src/"
        }
    },
    "keywords": ["laravel", "livewire", "tailwind", "alpine", "components", "ui", "tall-stack"],
    "homepage": "https://github.com/mijn-ui/mijn-ui-tall",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "suggest": {
        "livewire/livewire": "Required for interactive components (^3.5.19)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mijnui\\Mijnui\\MijnuiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
