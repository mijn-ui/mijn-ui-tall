{
    "name": "mijnui/mijnui",
    "description": "UI component library for Laravel.",
    "type": "library",
    "license": "MIT",
    "version": "v0.1.0",
    "authors": [
        {
            "name": "paingsoeko",
            "email": "dev.kopaing@gmail.com"
        },
        {
            "name": "WaiYanPhoneAant",
            "email": "waiyanphoneaantse@gmail.com"
        },
        {
            "name": "Zai185",
            "email": "mkhant185@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Mijnui\\Mijnui\\": "src/"
        }
    },
    "require": {
        "php": "^8.1"
    },
    "suggest": {
        "laravel/frontend-preset": "For scaffolding frontend assets like Tailwind CSS and Alpine.js."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mijnui\\Mijnui\\MijnuiServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-develop": "1.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0"
    }
}
